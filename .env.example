# Copy to .env for local development. Never commit the real .env.
# Development defaults are not suitable for a public server.
# For existing databases, use scripts/rotate_secrets.py to rotate credentials.

# Postgres
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://rag:rag@postgres:5432/rag

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000
APP_ENV=development

# Document ingestion
INGEST_MAX_BYTES=20971520
CHUNK_MIN_TOKENS=140
CHUNK_MAX_TOKENS=220
CHUNK_OVERLAP_TOKENS=40

# Embedding. Preserve the trailing spaces in the e5 prefixes.
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_PASSAGE_PREFIX="passage: "
# Optional local snapshot. Compose overrides host paths with /models/... paths.
EMBEDDING_MODEL_PATH=
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu
HF_HOME=./data/runtime/models
HF_ENDPOINT=https://hf-mirror.com

# Dense search
DENSE_TOP_K=10
DENSE_MAX_TOP_K=100
VECTOR_INDEX_TYPE=hnsw
IVFFLAT_LISTS=100

# Sparse search
SPARSE_TOP_K=10
SPARSE_MAX_TOP_K=100

# Hybrid search and reciprocal rank fusion
HYBRID_TOP_K=50
HYBRID_DENSE_CANDIDATES=100
HYBRID_SPARSE_CANDIDATES=100
RRF_K=60

# Cross-Encoder reranking
RERANK_MODEL_NAME=BAAI/bge-reranker-base
# Download with scripts/download_rerank_model.py; keep machine paths in .env.
RERANK_MODEL_PATH=
RERANK_DEVICE=cpu
RERANK_BATCH_SIZE=16
RERANK_TOP_K=8
RERANK_MAX_TOP_K=50
RERANK_CANDIDATES=50
# Concurrent scoring calls per process. 0 removes the limit.
RERANK_MAX_INFLIGHT=1

# LLM routing. API keys must remain empty in this template.
# Match the Qwen Base URL to the key's region and billing plan.
# Use the compatible-mode root URL, without /chat/completions.
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ANSWER_LLM_PROVIDER=qwen
ANSWER_LLM_MODEL=qwen3.8-max
TASK_LLM_PROVIDER=qwen
TASK_LLM_MODEL=qwen3.8-flash
# Legacy setting; explicit ANSWER_LLM_* / TASK_LLM_* settings take precedence.
LLM_PROVIDER=kimi
# Offline/CI only: ANSWER_LLM_PROVIDER=stub and APP_ENV must not be production.
ALLOW_LLM_STUB=false

# Optional providers. Select them explicitly using the routing settings above.
MOONSHOT_API_KEY=
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
LLM_KIMI_MODEL=kimi-k2.6
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_DEEPSEEK_MODEL=deepseek-v4-flash
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_GEMINI_MODEL=gemini-3.5-flash
LLM_OPENAI_MODEL=gpt-4o-mini
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TEMPERATURE=0.2
# Extra attempts for HTTP 429/timeouts. Authentication errors are not retried.
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_SECONDS=0.4
LLM_RETRY_MAX_SECONDS=8

# Question answering, verification, and saved traces
QA_TOP_K=8
QA_MAX_CONTEXT_CHARS=6000
QA_VERIFY=true
VERIFY_ENTAIL_THRESHOLD=0.35
VERIFY_LEXICAL_THRESHOLD=0.45
VERIFY_LEXICAL_GATE=0.15
QA_PERSIST_TRACES=true

# Authentication and CORS. Never disable authentication on a public server.
# Production rejects wildcard CORS and the development credentials below.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_ENABLED=true
JWT_SECRET=dev-only-change-me
JWT_EXPIRE_HOURS=168
# users.role=admin is the main gate. Leave username/id fallbacks unconfigured.
# Grant the intended account access using scripts/pin_eval_gate.py.
EVAL_GATE_USER_ID=
EVAL_GATE_USERNAME=

# Agent factoid tasks
AGENT_MAX_STEPS=8
AGENT_PLANNER=auto
AGENT_MIN_COVERAGE_RATE=0.5
AGENT_MAX_RETRIEVES=2

# Agent synthesis tasks
AGENT_SYNTHESIS_MAX_STEPS=22
AGENT_SYNTHESIS_MAX_SUBTOPICS=6
AGENT_SYNTHESIS_MAX_RETRIEVES=8
AGENT_SYNTHESIS_MAX_CATALOG_SECTIONS=80
AGENT_SYNTHESIS_MIN_MODULE_COVERAGE=0.5
AGENT_SYNTHESIS_SECTION_SCORE_MIN=0.1
# Cosine threshold for attaching sections, not for changing search rank.
AGENT_SECTION_HINT_MIN=0.45
# Reject evidence below this sigmoid reranker score.
AGENT_RETRIEVE_MIN_SCORE=0.02
AGENT_HIT_SEMANTIC_MIN=0.1
AGENT_NEIGHBOR_RADIUS=1
AGENT_SYNTHESIS_MAX_EVIDENCE=16
AGENT_WEAK_NODE_SCORE=0.15

# Bounded document reading
AGENT_DIGEST_MAX_DOCS=8
AGENT_DIGEST_MAX_CHARS=6000

# Search cache
SEARCH_CACHE_ENABLED=true
SEARCH_CACHE_TTL=3600

# Knowledge graph. Retrieval expansion is opt-in.
GRAPH_ENABLED=true
GRAPH_EXTRACT_MAX_CHUNKS=10
GRAPH_EXTRACT_MAX_TOKENS=4096
GRAPH_EXTRACT_MIN_CHARS=800
GRAPH_EXTRACT_WINDOW_CHARS=6000
# Only used with TASK_LLM_PROVIDER=deepseek; Qwen uses TASK_LLM_MODEL.
GRAPH_EXTRACT_DEEPSEEK_MODEL=deepseek-chat
GRAPH_EXPAND_ENABLED=false
GRAPH_EXPAND_HOPS=2

# Rate limits
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_QUERY_PER_MINUTE=20
RATE_LIMIT_AGENT_PER_MINUTE=3
RATE_LIMIT_JOBS_PER_MINUTE=10
RATE_LIMIT_AGENT_CONCURRENCY=1

# Candidate diagnostics can reveal corpus IDs/scores; keep disabled by default.
SEARCH_TRACE_CANDIDATES=false

# BM25 snapshot prototype. Requires migration 0011sparsegen; opt-in.
SPARSE_INDEX_CACHE_ENABLED=false
SPARSE_INDEX_CACHE_MAX_ENTRIES=4
SPARSE_INDEX_CACHE_MAX_BYTES=268435456
SPARSE_INDEX_CACHE_MAX_CHUNKS=250000
SPARSE_INDEX_CACHE_MAX_SOURCE_CHARS=16000000
SPARSE_INDEX_CACHE_WAIT_SECONDS=5
